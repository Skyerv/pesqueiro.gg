# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Endereço público do site (sem barra no final). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://seu-site.vercel.app

# Opcional: código que a turma precisa digitar para criar conta.
# Deixe vazio para liberar o cadastro para qualquer pessoa com o link.
INVITE_CODE=

# Opcional: identificação de espécie por IA nas fotos. Configure UMA das duas opções.
# Sem nenhuma chave o site funciona normalmente, só sem a sugestão automática.

# Opção gratuita: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo usado (opcional). O padrão é o Gemini 3.5 Flash-Lite, que tem plano gratuito.
GEMINI_MODEL=gemini-3.5-flash-lite

# Opção paga: Claude, da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo usado (opcional). O padrão é o Claude Haiku 4.5, rápido e barato.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Com as duas chaves, o Gemini é usado. Para forçar uma delas: gemini ou anthropic.
AI_PROVIDER=

# Opcional: aba Sugestões. Cada sugestão vira uma issue no GitHub com a etiqueta "sugestão".
# Token fine-grained com acesso só a este repositório e permissão Issues: Read and write.
GITHUB_TOKEN=
# Repositório no formato dono/nome. O padrão é Kauecsilva/pesqueiro.gg.
GITHUB_REPO=Kauecsilva/pesqueiro.gg
