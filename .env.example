# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Endereço público do site (sem barra no final). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://seu-site.vercel.app

# Opcional: código que a turma precisa digitar para criar conta.
# Deixe vazio para liberar o cadastro para qualquer pessoa com o link.
INVITE_CODE=

# Opcional: identificação de espécie por IA nas fotos (https://console.anthropic.com)
# Sem essa chave o site funciona normalmente, só sem a sugestão automática.
ANTHROPIC_API_KEY=
# Modelo usado (opcional). O padrão é o Claude Haiku 4.5, rápido e barato.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
